// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AreaType {
  PSYCHOLOGICAL
  TECHNICAL
}

model Competency {
  id          String    @id @default(uuid())
  area        AreaType
  name        String
  description String    @default("")
  sortOrder   Int
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  scores      Score[]
  positions   PositionCompetency[]

  @@map("competencies")
}

model Position {
  id           String    @id @default(uuid())
  name         String
  sortOrder    Int
  archivedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  athletes     Athlete[]
  competencies PositionCompetency[]

  @@map("positions")
}

model PositionCompetency {
  positionId   String
  position     Position   @relation(fields: [positionId], references: [id], onDelete: Cascade)
  competencyId String
  competency   Competency @relation(fields: [competencyId], references: [id], onDelete: Cascade)
  sortOrder    Int        @default(0) // order of this competency within THIS position's wheel (a shared competency can rank differently per position)

  @@id([positionId, competencyId])
  @@map("position_competencies")
}

model Team {
  id        String    @id @default(uuid())
  name      String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  athletes  Athlete[]

  @@map("teams")
}

model Athlete {
  id         String    @id @default(uuid())
  teamId     String
  team       Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  name       String
  positionId String?
  position   Position? @relation(fields: [positionId], references: [id], onDelete: SetNull)
  sortOrder  Int       @default(0)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  scores     Score[]

  @@index([teamId])
  @@index([positionId])
  @@map("athletes")
}

model Score {
  athleteId    String
  athlete      Athlete    @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  competencyId String
  competency   Competency @relation(fields: [competencyId], references: [id], onDelete: Cascade)
  value        Int
  updatedAt    DateTime   @updatedAt

  @@id([athleteId, competencyId])
  @@map("scores")
}
