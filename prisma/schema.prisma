// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AreaType {
  PSYCHOLOGICAL
  TECHNICAL
  SCOUTING
}

model Competency {
  id            String               @id @default(uuid())
  area          AreaType
  name          String
  description   String               @default("")
  sortOrder     Int
  archivedAt    DateTime?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  scores        Score[]
  positions     PositionCompetency[]
  scoutingNotes ScoutingNote[]

  @@map("competencies")
}

model Position {
  id           String               @id @default(uuid())
  name         String
  sortOrder    Int
  archivedAt   DateTime?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  athletes     Athlete[]
  competencies PositionCompetency[]
  prospects    Prospect[]

  @@map("positions")
}

model PositionCompetency {
  positionId   String
  position     Position   @relation(fields: [positionId], references: [id], onDelete: Cascade)
  competencyId String
  competency   Competency @relation(fields: [competencyId], references: [id], onDelete: Cascade)
  sortOrder    Int        @default(0) // order of this competency within THIS position's wheel (a shared competency can rank differently per position)

  @@id([positionId, competencyId])
  @@map("position_competencies")
}

model Team {
  id        String    @id @default(uuid())
  name      String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  athletes  Athlete[]

  @@map("teams")
}

model Athlete {
  id         String    @id @default(uuid())
  teamId     String
  team       Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  name       String
  positionId String?
  position   Position? @relation(fields: [positionId], references: [id], onDelete: SetNull)
  sortOrder  Int       @default(0)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  scores     Score[]
  prospect   Prospect?
  student    Student?

  @@index([teamId])
  @@index([positionId])
  @@map("athletes")
}

model Score {
  athleteId    String
  athlete      Athlete    @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  competencyId String
  competency   Competency @relation(fields: [competencyId], references: [id], onDelete: Cascade)
  value        Int
  updatedAt    DateTime   @updatedAt

  @@id([athleteId, competencyId])
  @@map("scores")
}

model Prospect {
  id          String               @id @default(uuid())
  name        String
  positionId  String?
  position    Position?            @relation(fields: [positionId], references: [id], onDelete: SetNull)
  club        String?
  athleteId   String?              @unique
  athlete     Athlete?             @relation(fields: [athleteId], references: [id], onDelete: SetNull)
  archivedAt  DateTime?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  notes       ScoutingNote[]
  evaluations ScoutingEvaluation[]

  @@map("prospects")
}

model ScoutingNote {
  prospectId   String
  prospect     Prospect   @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  competencyId String
  competency   Competency @relation(fields: [competencyId], references: [id], onDelete: Cascade)
  note         String     @default("")
  updatedAt    DateTime   @updatedAt

  @@id([prospectId, competencyId])
  @@map("scouting_notes")
}

enum EvaluationCadence {
  POR_JOGO
  PERIODICA
}

// Uma submissão do formulário de avaliação psicológica de scouting (sliders
// 0-10 por KPI). O catálogo de KPIs (peso, nome, cadência) vive em
// lib/scouting-kpi/kpiData.ts, não na base de dados — por isso "scores" e
// "gameContext" ficam em Json em vez de linhas normalizadas por KPI.
model ScoutingEvaluation {
  id          String            @id @default(uuid())
  prospectId  String
  prospect    Prospect          @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  cadence     EvaluationCadence
  scores      Json // kpiId -> 0-10
  notas       String            @default("")
  gameContext Json? // snapshot of GameContext, only set for cadence = POR_JOGO
  avaliador   String            @default("") // nome de quem preencheu, para o cabeçalho do PDF
  periodo     String            @default("") // label do período avaliado, só para cadence = PERIODICA
  createdAt   DateTime          @default(now())

  @@index([prospectId])
  @@map("scouting_evaluations")
}

enum SchoolGroup {
  POUSADA
  UAARE
}

enum SlotKind {
  LESSON
  BREAK
}

// Aluno-atleta da secção Escolar. O horário vive diretamente no aluno: cada
// aluno tem os seus próprios blocos (TimeSlot), porque escolas diferentes têm
// horas de entrada, intervalos e durações de aula diferentes. Copiar o horário
// de um colega duplica blocos e aulas. A ligação a um atleta é opcional.
model Student {
  id              String      @id @default(uuid())
  name            String
  group           SchoolGroup
  school          String      @default("")
  schoolYear      String      @default("")
  className       String      @default("")
  includeSaturday Boolean     @default(false)
  athleteId       String?     @unique
  athlete         Athlete?    @relation(fields: [athleteId], references: [id], onDelete: SetNull)
  sortOrder       Int         @default(0)
  archivedAt      DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  slots           TimeSlot[]

  @@index([group])
  @@map("students")
}

model TimeSlot {
  id        String   @id @default(uuid())
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  startMin  Int // minutos desde as 00:00 (08:15 = 495)
  endMin    Int
  kind      SlotKind @default(LESSON)
  label     String   @default("") // "Intervalo", "Almoço" — só usado em BREAK
  lessons   Lesson[]

  @@index([studentId])
  @@map("time_slots")
}

model Lesson {
  slotId  String
  slot    TimeSlot @relation(fields: [slotId], references: [id], onDelete: Cascade)
  weekday Int // 1 = segunda … 6 = sábado
  subject String
  room    String   @default("")
  teacher String   @default("")

  @@id([slotId, weekday])
  @@map("lessons")
}
